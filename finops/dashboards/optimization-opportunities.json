{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Top 20 cost optimization opportunities: underutilized workloads and unused volumes ranked by potential savings",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Total Potential Monthly Savings",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(finops_rightsizing_potential_monthly_savings)",
          "legendFormat": "Potential Savings",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Underutilized Workloads",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(avg by (pod, namespace) (rate(container_cpu_usage_seconds_total{container!=\"\"}[7d])) / avg by (pod, namespace) (kube_pod_container_resource_requests{resource=\"cpu\"}) * 100 < 20)",
          "legendFormat": "Count",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Unused PersistentVolumes",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(kube_persistentvolume_status_phase{phase=~\"Released|Available\"})",
          "legendFormat": "Unused PVs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Est. Annual Waste",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(finops_rightsizing_potential_monthly_savings) * 12",
          "legendFormat": "Annual",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto", "filterable": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 100 }] },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Monthly Savings ($)" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "custom.displayMode", "value": "color-background" }] },
          { "matcher": { "id": "byName", "options": "CPU Util %" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "custom.displayMode", "value": "color-background-solid" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 10 }, { "color": "green", "value": 20 }] } }] },
          { "matcher": { "id": "byName", "options": "Priority" }, "properties": [{ "id": "custom.displayMode", "value": "color-text" }, { "id": "mappings", "value": [{ "options": { "high": { "color": "red", "index": 0 }, "medium": { "color": "yellow", "index": 1 }, "low": { "color": "green", "index": 2 } }, "type": "value" }] }] }
        ]
      },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 4 },
      "id": 5,
      "options": { "footer": { "show": false }, "sortBy": [{ "displayName": "Monthly Savings ($)", "desc": true }] },
      "title": "Top 20 Optimization Opportunities — Underutilized Workloads",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sort_desc(topk(20, (1 - avg by (pod, namespace) (rate(container_cpu_usage_seconds_total{container!=\"\"}[7d])) / avg by (pod, namespace) (kube_pod_container_resource_requests{resource=\"cpu\"})) * avg by (pod, namespace) (kube_pod_container_resource_requests{resource=\"cpu\"}) * 0.048 * 730))",
          "legendFormat": "{{namespace}}/{{pod}}",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "namespace": "Namespace", "pod": "Pod", "Value": "Monthly Savings ($)" } } }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto", "filterable": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Monthly Cost ($)" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "custom.displayMode", "value": "color-background" }] }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "id": 6,
      "options": { "footer": { "show": false }, "sortBy": [{ "displayName": "Monthly Cost ($)", "desc": true }] },
      "title": "Unused PersistentVolumes (Released / Available)",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "kube_persistentvolume_status_phase{phase=~\"Released|Available\"} * on(persistentvolume) group_left(storageclass) kube_persistentvolume_info",
          "legendFormat": "{{persistentvolume}} ({{storageclass}})",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "displayMode": "auto", "filterable": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 7 }, { "color": "red", "value": 30 }] },
          "unit": "dtdurations"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "estimated_monthly_savings_usd" }, "properties": [{ "id": "displayName", "value": "Estimated Monthly Savings" }, { "id": "unit", "value": "currencyUSD" }] },
          { "matcher": { "id": "byName", "options": "generate_pr_command" }, "properties": [{ "id": "displayName", "value": "Generate PR Command" }] }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "id": 7,
      "options": { "footer": { "show": false }, "sortBy": [{ "displayName": "recommendation_age_days", "desc": true }] },
      "title": "VPA Recommendation Age",
      "type": "table",
      "description": "Workloads with VPA recommendations older than 7 days and expected savings.",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "finops_vpa_recommendation_age_days > 7",
          "instant": true,
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "namespace": "Namespace", "workload": "Workload", "Value": "recommendation_age_days", "estimated_monthly_savings_usd": "estimated_monthly_savings_usd", "generate_pr_command": "generate_pr_command" } } }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 100 }, { "color": "green", "value": 500 }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 38 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "title": "Optimization Savings Realized",
      "type": "stat",
      "description": "Monthly savings realized from merged optimization changes. Metric source: ConfigMap updates written by generate-optimization-pr.py.",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(finops_optimization_savings_realized_monthly_usd)",
          "legendFormat": "Savings Realized",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 38 },
      "id": 9,
      "title": "Reserved vs On-Demand Spend",
      "type": "piechart",
      "description": "Breakdown by commitment type. # <-- CHANGE THIS: apply finops.io/commitment-type label via your Terraform modules.",
      "options": { "displayLabels": ["name", "percent"], "legend": { "displayMode": "table", "placement": "right" }, "pieType": "pie", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (commitment_type) (finops_commitment_spend_monthly_usd)",
          "legendFormat": "{{commitment_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "currencyUSD" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 38 },
      "id": 10,
      "title": "Cross-Cloud Cost Comparison",
      "type": "barchart",
      "description": "Normalized cost per team per cloud from normalize-cloud-costs.py ConfigMap publication.",
      "options": { "orientation": "auto", "showValue": "auto", "stacking": "normal" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (team, cloud) (finops_normalized_cost_usd)",
          "legendFormat": "{{team}}/{{cloud}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10m",
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["finops", "optimization"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(kube_pod_info, namespace)",
        "label": "Namespace",
        "name": "namespace",
        "options": [],
        "query": { "query": "label_values(kube_pod_info, namespace)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "FinOps — Optimization Opportunities",
  "uid": "finops-optimization-opportunities",
  "version": 1
}
