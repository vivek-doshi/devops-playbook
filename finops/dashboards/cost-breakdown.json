{
  "__inputs": [{ "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "description": "Cost breakdown by resource type (compute/storage/network), workload type, and namespace with drill-down links.",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 38,
  "tags": ["finops", "cost-breakdown"],
  "time": { "from": "now-30d", "to": "now" },
  "timezone": "browser",
  "title": "FinOps - Cost Breakdown",
  "uid": "finops-cost-breakdown",
  "version": 1,
  "templating": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(kubecost_namespace_cost_hourly, namespace)",
        "hide": 0, "includeAll": true, "allValue": ".*", "label": "Namespace", "multi": true, "name": "namespace",
        "query": { "query": "label_values(kubecost_namespace_cost_hourly, namespace)", "refId": "StandardVariableQuery" },
        "refresh": 2, "sort": 1, "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(kubecost_namespace_cost_hourly, cost_center)",
        "hide": 0, "includeAll": true, "allValue": ".*", "label": "Cost Center", "multi": true, "name": "cost_center",
        "query": { "query": "label_values(kubecost_namespace_cost_hourly, cost_center)", "refId": "StandardVariableQuery" },
        "refresh": 2, "sort": 1, "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(kubecost_namespace_cost_hourly, environment)",
        "hide": 0, "includeAll": true, "allValue": ".*", "label": "Environment", "multi": true, "name": "environment",
        "query": { "query": "label_values(kubecost_namespace_cost_hourly, environment)", "refId": "StandardVariableQuery" },
        "refresh": 2, "sort": 1, "type": "query"
      }
    ]
  },
  "panels": [
    { "id": 1, "title": "Resource Type Cost Breakdown", "type": "row", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "title": "Compute Cost (USD/hr)", "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_compute_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Compute", "refId": "A" }]
    },
    {
      "id": 3, "title": "Storage Cost (USD/hr)", "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 50 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_storage_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Storage", "refId": "A" }]
    },
    {
      "id": 4, "title": "Network Cost (USD/hr)", "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 25 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_network_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Network", "refId": "A" }]
    },
    {
      "id": 5, "title": "Cost by Resource Type — Trend", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 15 }, "unit": "currencyUSD", "decimals": 2 } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_compute_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Compute", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_storage_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Storage", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_network_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Network", "refId": "C" }
      ]
    },
    {
      "id": 6, "title": "Resource Type Distribution", "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "currencyUSD", "decimals": 2 } },
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_compute_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Compute", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_storage_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Storage", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(kubecost_namespace_network_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "Network", "refId": "C" }
      ]
    },
    { "id": 10, "title": "Cost by Workload Type", "type": "row", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },
    {
      "id": 11, "title": "Cost by Workload Type", "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "currencyUSD", "decimals": 2 } },
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (workload_type) (kubecost_workload_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "{{workload_type}}", "refId": "A" }]
    },
    {
      "id": 12, "title": "Workload Type Cost Trend", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "currencyUSD", "decimals": 2 } },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (workload_type) (kubecost_workload_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\"})", "legendFormat": "{{workload_type}}", "refId": "A" }]
    },
    { "id": 20, "title": "Namespace Drill-Down", "type": "row", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 } },
    {
      "id": 21, "title": "Cost Per Namespace (click to drill down)", "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }, "unit": "currencyUSD", "decimals": 2 },
        "overrides": [{
          "matcher": { "id": "byName", "options": "namespace" },
          "properties": [{ "id": "links", "value": [{ "title": "View Namespace Cost Detail", "url": "/d/finops-cost-overview?var-namespace=${__value.raw}", "targetBlank": false }] }]
        }]
      },
      "options": { "sortBy": [{ "displayName": "Total Cost (USD/hr)", "desc": true }] },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (namespace, cost_center, environment) (kubecost_namespace_cost_hourly{namespace=~\"$namespace\",cost_center=~\"$cost_center\",environment=~\"$environment\"})", "legendFormat": "", "refId": "A", "instant": true, "format": "table" }],
      "transformations": [{ "id": "organize", "options": { "renameByName": { "namespace": "Namespace", "cost_center": "Cost Center", "environment": "Environment", "Value": "Total Cost (USD/hr)" } } }]
    }
  ]
}
