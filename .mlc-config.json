{
  "ignorePatterns": [
    { "pattern": "localhost" },
    { "pattern": "example\\.com" },
    { "pattern": "YOUR-ORG" },
    { "pattern": "your-org" },
    { "pattern": "my-app" },
    { "pattern": "my-service" },
    { "pattern": "grafana\\.internal\\.company\\.com" }
  ],
  "timeout": "20s",
  "maxRetries": 3,
  "retryWaitTime": "2s",
  "excludeAllPrivate": true
}
